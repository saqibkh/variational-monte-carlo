{
  "intellij-idea-keybindings.useCamelHumpsWords": true,
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--query-driver=/usr/bin/g++-15,/usr/local/cuda-*/bin/nvcc"
  ],
  "files.associations": {
    "*.cu": "cuda-cpp"
  }
}
